# ---- 行情快照与产品净值：一律不入库（仓库为 public） ----
/data/*
!/data/README.md
*.csv
!data_contracts/*.csv
!experiments/*/metrics_table.csv
# WORK-503 的交付物清单里点名引用的两张人读表（按档聚合表 + 成本敏感性表）
!experiments/*/metrics_by_arm.csv
!experiments/*/cost_sensitivity.csv

# ---- 图件产物（大图 + 对齐/碰撞审计 JSON），只保留生成脚本 ----
/figures/*
!/figures/README.md
*.png
*.pdf
*.svg
!docs/**/*.png

# ---- 报告成品（内嵌 base64 图件，体积大且可由模板重建） ----
report.html
**/report.html

# ---- WORK-449 例外：本单的交付物必须可核验，报告成品入库 ----
# 单文件 HTML 报告 + 1440x900 首屏 PNG + A4 打印 PDF + 论文对照 CSV + 图件
!experiments/WORK-449/report.html
!experiments/WORK-449/preview_first_screen.png
!experiments/WORK-449/report_print.pdf
!experiments/WORK-449/report_print_full.pdf
!experiments/WORK-449/paper_comparison.csv
!/figures/WORK-449/
!/figures/WORK-449/*.png

# ---- WORK-503 例外：报告成品与论文对照表入库 ----
!experiments/WORK-503/report.html
!experiments/WORK-503/preview_first_screen.png
!experiments/WORK-503/report_print.pdf
!experiments/WORK-503/paper_comparison.csv
!/figures/WORK-503/
!/figures/WORK-503/*.png

# ---- WORK-557 例外：报告成品与论文对照表入库 ----
!experiments/WORK-557/report.html
!experiments/WORK-557/preview_first_screen.png
!experiments/WORK-557/report_print.pdf
!experiments/WORK-557/paper_comparison.csv
!experiments/WORK-557/old_vs_new_comparison.csv
!/figures/WORK-557/
!/figures/WORK-557/*.png

# ---- 中间产物（预测 parquet / 逐日面板）：可由训练与回测脚本重建，不入库 ----
*.parquet

# ---- 复跑产物（probe 脚本默认输出目录）：不入库，避免覆盖已入库的实测证据 ----
experiments/*/rerun/

# ---- Python ----
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# ---- 本机与编辑器 ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# ---- WORK-449 二进制产物（面板 / 因子 / 模型 / 权重）：可由脚本重建，不入库 ----
*.npz
*.pt

# ---- WORK-449 作废轮次产物（协方差缺陷修复前的运行结果，不作证据） ----
experiments/WORK-449/void_run_*/

# ---- 上游模型 checkpoint（体积大，可由训练脚本重建） ----
vendor/PRISM-VQ/checkpoints/
