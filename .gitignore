# ---- 行情快照与产品净值：一律不入库（仓库为 public） ----
/data/*
!/data/README.md
*.csv
!data_contracts/*.csv
!experiments/*/metrics_table.csv

# ---- 图件产物（大图 + 对齐/碰撞审计 JSON），只保留生成脚本 ----
/figures/*
!/figures/README.md
*.png
*.pdf
*.svg
!docs/**/*.png

# ---- 报告成品（内嵌 base64 图件，体积大且可由模板重建） ----
report.html
**/report.html

# ---- 复跑产物（probe 脚本默认输出目录）：不入库，避免覆盖已入库的实测证据 ----
experiments/*/rerun/

# ---- Python ----
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# ---- 本机与编辑器 ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# ---- WORK-449 二进制产物（面板 / 因子 / 模型 / 权重）：可由脚本重建，不入库 ----
*.npz
*.pt
